[Unit]
Description=FoxFlow proactive service monitoring
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/foxflow-monitor.env
ExecStart=/usr/local/sbin/foxflow-monitor
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foxflow-monitor
