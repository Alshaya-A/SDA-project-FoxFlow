[Unit]
Description=FoxFlow AI DevOps Copilot for Telegram
After=docker.service network-online.target foxflow-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=foxflow-copilot
Group=foxflow-copilot
EnvironmentFile=/etc/foxflow/copilot.env
WorkingDirectory=/opt/foxflow/copilot
ExecStart=/opt/foxflow/copilot/ai-copilot.sh
Restart=always
RestartSec=5s
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/lib/foxflow-copilot /srv/foxflow
UMask=0077

[Install]
WantedBy=multi-user.target
