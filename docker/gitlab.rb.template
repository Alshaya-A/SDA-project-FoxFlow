# GitLab Omnibus configuration template
#
# This file documents recommended settings for /etc/gitlab/gitlab.rb
# when deploying on the Azure VM. Most values in docker-compose.yml
# override these via GITLAB_OMNIBUS_CONFIG, but this file serves as
# a reference and for settings that don't fit as env vars.

# External URL - MUST match your public hostname
# external_url 'https://gitlab.yourdomain.com'

# Backup retention (in seconds). 604800 = 7 days
# gitlab_rails['backup_keep_time'] = 604800

# SMTP configuration for email notifications (optional)
# gitlab_rails['smtp_enable'] = true
# gitlab_rails['smtp_address'] = "smtp.example.com"
# gitlab_rails['smtp_port'] = 587
# gitlab_rails['smtp_authentication'] = "login"
# gitlab_rails['smtp_tls'] = true

# Prometheus monitoring - disable if not used
# prometheus_monitoring['enable'] = false

# Reduce memory usage for smaller VMs (recommended: 8GB+ RAM)
# puma['worker_processes'] = 2
# sidekiq['max_concurrency'] = 15
